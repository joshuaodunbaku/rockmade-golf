# Backend API base URL.
# Read by src/axios/axios-instances.js (axiosInstance + axiosRefreshInstance).
# Copy this file to .env.local and adjust, or set the variable in your host
# (e.g. Vercel > Project > Settings > Environment Variables).
#
# When unset, the app falls back to the local backend: http://localhost:2026
VITE_API_URL=http://localhost:2026
